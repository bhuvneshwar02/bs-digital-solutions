# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Local:  mongodb://127.0.0.1:27017/bs-innovation
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/bs-innovation?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bs-innovation

# --- Auth ---
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173

# --- First admin (used only by `npm run seed` when no users exist) ---
SEED_ADMIN_NAME=Bhuvneshwar Sharma
SEED_ADMIN_EMAIL=bhuvneshwarsharma44@gmail.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
