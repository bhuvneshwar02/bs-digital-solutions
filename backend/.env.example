# Copy to .env and fill in. On Render, set these as environment variables instead.

NODE_ENV=production
PORT=4000

# Local:  mongodb://127.0.0.1:27017/bs-innovation
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/bs-innovation?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bs-innovation

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed frontend origins (comma-separated). The live site:
CORS_ORIGIN=https://bsinnovationsolutions.com,https://www.bsinnovationsolutions.com

# First admin — used by `npm run seed` only when there are no users yet.
SEED_ADMIN_NAME=Bhuvneshwar Sharma
SEED_ADMIN_EMAIL=bhuvneshwarsharma44@gmail.com
SEED_ADMIN_PASSWORD=change-me-then-change-again-in-admin

# Email via Resend (optional — submissions are still saved without it).
# MAIL_FROM must be onboarding@resend.dev until bsinnovationsolutions.com is
# verified in Resend (a gmail.com address will NOT work).
RESEND_API_KEY=
MAIL_FROM=BS Innovation Solutions <onboarding@resend.dev>
MAIL_TO=bhuvneshwarsharma44@gmail.com
